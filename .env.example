# Database
DATABASE_URL=postgres://nuclave:nuclave@localhost:5432/nuclave

# Redis (for real-time pub/sub)
REDIS_URL=redis://localhost:6379

# AI Provider: "anthropic" | "openai" | "ollama"
AI_PROVIDER=anthropic

# Anthropic (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-xxx

# Ollama (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model
EMBEDDING_PROVIDER=openai
# openai: text-embedding-3-small
# ollama: nomic-embed-text

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
